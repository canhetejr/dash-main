# Google Sheets API Configuration
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SHEETS_RANGE=TRATAMENTO!A:M
GOOGLE_SHEETS_MOODLE_BASE_RANGE=BASE!A:B
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# Uma linha com \n entre os blocos da chave; sem espaços após BEGIN/END; sem aspas duplas dentro do PEM.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Development: set to "true" to use mock data instead of Google Sheets
USE_MOCK_DATA=true

# Runtime port (Docker/Coolify). A app roda em 3000 por padrão.
PORT=3000

# Optional fallback (caso a aba BASE não traga url para algum id)
# Exemplo de placeholder: https://moodle.seudominio/course/view.php?id={{id}}
MOODLE_URL_TEMPLATE=https://ava.graduacaoead.unicv.edu.br/course/view.php?id={{id}}


